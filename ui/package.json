{
  "name": "drusite-ui",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "tauri": "TAURI_APP_PATH=../crates/drusite-app TAURI_FRONTEND_PATH=. tauri",
    "test:browser": "playwright test",
    "wasm": "scripts/wasm.sh",
    "build:web": "vite build --mode web && node scripts/compress.mjs",
    "test:web": "playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.2",
    "prosemirror-inputrules": "1.7.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.7",
    "prosemirror-view": "1.44.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.6",
    "jsdom": "31.0.1",
    "svelte": "5.59.2",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
